<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    RetroArcDo HD Studio design system v0.3.
    The complete palette and every control brush live in matching Dark and Light
    theme dictionaries, so switching appearance re-themes panels, text, status
    colours and Fluent control accents together. Icons are Lucide 0.468 (ISC).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="StudioBgColor">#181B20</Color>
      <Color x:Key="StudioPanelColor">#22262D</Color>
      <Color x:Key="StudioPanelAltColor">#1D2127</Color>
      <Color x:Key="StudioElevatedColor">#2D333C</Color>
      <Color x:Key="StudioInputColor">#1B1F25</Color>
      <Color x:Key="StudioBorderColor">#3B424C</Color>
      <Color x:Key="StudioBorderStrongColor">#4B545F</Color>
      <Color x:Key="StudioTextColor">#F0F2F5</Color>
      <Color x:Key="StudioTextSecondaryColor">#A5AFBD</Color>
      <Color x:Key="StudioTextTertiaryColor">#748091</Color>
      <Color x:Key="StudioAccentColor">#F28C38</Color>
      <Color x:Key="StudioAccentHoverColor">#FFA04F</Color>
      <Color x:Key="StudioAccentPressedColor">#D97726</Color>
      <Color x:Key="StudioAccentSoftColor">#33F28C38</Color>
      <Color x:Key="StudioSuccessColor">#45B883</Color>
      <Color x:Key="StudioWarningColor">#E9B44C</Color>
      <Color x:Key="StudioErrorColor">#E16464</Color>
      <Color x:Key="StudioInfoColor">#5796DF</Color>
      <Color x:Key="StudioCanvasColor">#14171B</Color>
      <Color x:Key="StudioHoverColor">#343B45</Color>
      <Color x:Key="StudioSelectionColor">#2C3744</Color>
      <Color x:Key="StudioToolbarColor">#1E2228</Color>
      <Color x:Key="StudioStatusColor">#14171B</Color>
      <Color x:Key="StudioOverlayColor">#CC12151A</Color>
      <Color x:Key="SystemAccentColor">#F28C38</Color>
      <Color x:Key="SystemAccentColorLight1">#FFA04F</Color>
      <Color x:Key="SystemAccentColorLight2">#FFB36B</Color>
      <Color x:Key="SystemAccentColorLight3">#FFC58A</Color>
      <Color x:Key="SystemAccentColorDark1">#D97726</Color>
      <Color x:Key="SystemAccentColorDark2">#BC6318</Color>
      <Color x:Key="SystemAccentColorDark3">#9D5110</Color>
      <SolidColorBrush x:Key="StudioBgBrush" Color="{StaticResource StudioBgColor}" />
      <SolidColorBrush x:Key="StudioPanelBrush" Color="{StaticResource StudioPanelColor}" />
      <SolidColorBrush x:Key="StudioPanelAltBrush" Color="{StaticResource StudioPanelAltColor}" />
      <SolidColorBrush x:Key="StudioElevatedBrush" Color="{StaticResource StudioElevatedColor}" />
      <SolidColorBrush x:Key="StudioInputBrush" Color="{StaticResource StudioInputColor}" />
      <SolidColorBrush x:Key="StudioBorderBrush" Color="{StaticResource StudioBorderColor}" />
      <SolidColorBrush x:Key="StudioBorderStrongBrush" Color="{StaticResource StudioBorderStrongColor}" />
      <SolidColorBrush x:Key="StudioTextBrush" Color="{StaticResource StudioTextColor}" />
      <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="{StaticResource StudioTextSecondaryColor}" />
      <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="{StaticResource StudioTextTertiaryColor}" />
      <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccentColor}" />
      <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="{StaticResource StudioAccentHoverColor}" />
      <SolidColorBrush x:Key="StudioAccentPressedBrush" Color="{StaticResource StudioAccentPressedColor}" />
      <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="{StaticResource StudioAccentSoftColor}" />
      <SolidColorBrush x:Key="StudioSuccessBrush" Color="{StaticResource StudioSuccessColor}" />
      <SolidColorBrush x:Key="StudioWarningBrush" Color="{StaticResource StudioWarningColor}" />
      <SolidColorBrush x:Key="StudioErrorBrush" Color="{StaticResource StudioErrorColor}" />
      <SolidColorBrush x:Key="StudioInfoBrush" Color="{StaticResource StudioInfoColor}" />
      <SolidColorBrush x:Key="StudioCanvasBrush" Color="{StaticResource StudioCanvasColor}" />
      <SolidColorBrush x:Key="StudioHoverBrush" Color="{StaticResource StudioHoverColor}" />
      <SolidColorBrush x:Key="StudioSelectionBrush" Color="{StaticResource StudioSelectionColor}" />
      <SolidColorBrush x:Key="StudioToolbarBrush" Color="{StaticResource StudioToolbarColor}" />
      <SolidColorBrush x:Key="StudioStatusBrush" Color="{StaticResource StudioStatusColor}" />
      <SolidColorBrush x:Key="StudioOverlayBrush" Color="{StaticResource StudioOverlayColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="StudioBgColor">#F3F5F8</Color>
      <Color x:Key="StudioPanelColor">#FFFFFF</Color>
      <Color x:Key="StudioPanelAltColor">#E9EDF2</Color>
      <Color x:Key="StudioElevatedColor">#E1E7EE</Color>
      <Color x:Key="StudioInputColor">#FFFFFF</Color>
      <Color x:Key="StudioBorderColor">#C9D2DC</Color>
      <Color x:Key="StudioBorderStrongColor">#AAB6C3</Color>
      <Color x:Key="StudioTextColor">#1B2430</Color>
      <Color x:Key="StudioTextSecondaryColor">#556273</Color>
      <Color x:Key="StudioTextTertiaryColor">#788697</Color>
      <Color x:Key="StudioAccentColor">#D97726</Color>
      <Color x:Key="StudioAccentHoverColor">#C96818</Color>
      <Color x:Key="StudioAccentPressedColor">#B85C10</Color>
      <Color x:Key="StudioAccentSoftColor">#22D97726</Color>
      <Color x:Key="StudioSuccessColor">#248A5C</Color>
      <Color x:Key="StudioWarningColor">#A87400</Color>
      <Color x:Key="StudioErrorColor">#C33D3D</Color>
      <Color x:Key="StudioInfoColor">#2E6DB4</Color>
      <Color x:Key="StudioCanvasColor">#DDE3EA</Color>
      <Color x:Key="StudioHoverColor">#D7DFE8</Color>
      <Color x:Key="StudioSelectionColor">#CFE1F3</Color>
      <Color x:Key="StudioToolbarColor">#FFFFFF</Color>
      <Color x:Key="StudioStatusColor">#E9EDF2</Color>
      <Color x:Key="StudioOverlayColor">#DDF3F5F8</Color>
      <Color x:Key="SystemAccentColor">#D97726</Color>
      <Color x:Key="SystemAccentColorLight1">#E88A38</Color>
      <Color x:Key="SystemAccentColorLight2">#F2A052</Color>
      <Color x:Key="SystemAccentColorLight3">#F8B675</Color>
      <Color x:Key="SystemAccentColorDark1">#B85C10</Color>
      <Color x:Key="SystemAccentColorDark2">#984A08</Color>
      <Color x:Key="SystemAccentColorDark3">#793A05</Color>
      <SolidColorBrush x:Key="StudioBgBrush" Color="{StaticResource StudioBgColor}" />
      <SolidColorBrush x:Key="StudioPanelBrush" Color="{StaticResource StudioPanelColor}" />
      <SolidColorBrush x:Key="StudioPanelAltBrush" Color="{StaticResource StudioPanelAltColor}" />
      <SolidColorBrush x:Key="StudioElevatedBrush" Color="{StaticResource StudioElevatedColor}" />
      <SolidColorBrush x:Key="StudioInputBrush" Color="{StaticResource StudioInputColor}" />
      <SolidColorBrush x:Key="StudioBorderBrush" Color="{StaticResource StudioBorderColor}" />
      <SolidColorBrush x:Key="StudioBorderStrongBrush" Color="{StaticResource StudioBorderStrongColor}" />
      <SolidColorBrush x:Key="StudioTextBrush" Color="{StaticResource StudioTextColor}" />
      <SolidColorBrush x:Key="StudioTextSecondaryBrush" Color="{StaticResource StudioTextSecondaryColor}" />
      <SolidColorBrush x:Key="StudioTextTertiaryBrush" Color="{StaticResource StudioTextTertiaryColor}" />
      <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccentColor}" />
      <SolidColorBrush x:Key="StudioAccentHoverBrush" Color="{StaticResource StudioAccentHoverColor}" />
      <SolidColorBrush x:Key="StudioAccentPressedBrush" Color="{StaticResource StudioAccentPressedColor}" />
      <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="{StaticResource StudioAccentSoftColor}" />
      <SolidColorBrush x:Key="StudioSuccessBrush" Color="{StaticResource StudioSuccessColor}" />
      <SolidColorBrush x:Key="StudioWarningBrush" Color="{StaticResource StudioWarningColor}" />
      <SolidColorBrush x:Key="StudioErrorBrush" Color="{StaticResource StudioErrorColor}" />
      <SolidColorBrush x:Key="StudioInfoBrush" Color="{StaticResource StudioInfoColor}" />
      <SolidColorBrush x:Key="StudioCanvasBrush" Color="{StaticResource StudioCanvasColor}" />
      <SolidColorBrush x:Key="StudioHoverBrush" Color="{StaticResource StudioHoverColor}" />
      <SolidColorBrush x:Key="StudioSelectionBrush" Color="{StaticResource StudioSelectionColor}" />
      <SolidColorBrush x:Key="StudioToolbarBrush" Color="{StaticResource StudioToolbarColor}" />
      <SolidColorBrush x:Key="StudioStatusBrush" Color="{StaticResource StudioStatusColor}" />
      <SolidColorBrush x:Key="StudioOverlayBrush" Color="{StaticResource StudioOverlayColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="StudioTransparentBrush" Color="Transparent" />

  <!-- Canvas transparency checkerboard, derived from the current theme. -->
  <DrawingBrush x:Key="StudioCheckerBrush" TileMode="Tile" Stretch="None" AlignmentX="Left" AlignmentY="Top"
                SourceRect="0,0,16,16" DestinationRect="0,0,16,16">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{DynamicResource StudioPanelAltBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{DynamicResource StudioElevatedBrush}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,0,8,8" />
              <RectangleGeometry Rect="8,8,8,8" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>


  <!-- Fluent control resources are re-pointed at the Studio accent so checkboxes,
       sliders, focus rings and selected list rows share one visual language instead
       of the Windows default blue. -->
  <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightAltAccentBrush" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightAccentRevealBackgroundBrush" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{DynamicResource StudioAccentColor}" Opacity="0.20" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{DynamicResource StudioAccentColor}" Opacity="0.32" />
  <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="{DynamicResource StudioAccentColor}" Opacity="0.45" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource StudioAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource StudioAccentPressedColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource StudioAccentHoverColor}" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#171A1F" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#171A1F" />
  <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#171A1F" />
  <SolidColorBrush x:Key="SliderThumbBackground" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{DynamicResource StudioAccentHoverColor}" />
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{DynamicResource StudioAccentPressedColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{DynamicResource StudioAccentHoverColor}" />
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{DynamicResource StudioAccentPressedColor}" />
  <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource StudioAccentHoverColor}" />
  <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource StudioAccentPressedColor}" />
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{DynamicResource StudioAccentColor}" />
  <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource StudioAccentSoftColor}" />
  <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{DynamicResource StudioAccentColor}" />

